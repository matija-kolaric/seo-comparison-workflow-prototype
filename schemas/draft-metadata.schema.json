{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "draft-metadata.schema.json",
  "title": "Draft metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "draft_version", "content_path", "brief_path", "created_at", "claim_ids_used", "word_count"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "common.schema.json#/$defs/runId"},
    "draft_version": {"type": "integer", "minimum": 1},
    "content_path": {"type": "string", "minLength": 1},
    "brief_path": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "claim_ids_used": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/claimId"}},
    "word_count": {"type": "integer", "minimum": 0}
  }
}
