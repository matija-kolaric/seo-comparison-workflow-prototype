{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revision-request.schema.json",
  "title": "Consolidated revision request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source_draft_version", "target_draft_version", "generated_at", "source_reviews", "required_changes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "common.schema.json#/$defs/runId"},
    "source_draft_version": {"type": "integer", "minimum": 1},
    "target_draft_version": {"type": "integer", "minimum": 2},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "source_reviews": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "instruction", "claim_ids"],
        "properties": {
          "priority": {"enum": ["critical", "required", "recommended"]},
          "instruction": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/claimId"}}
        }
      }
    }
  }
}
