{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seo-review.schema.json",
  "title": "Draft SEO review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "draft_version", "generated_at", "status", "checks", "findings", "required_changes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "common.schema.json#/$defs/runId"},
    "draft_version": {"type": "integer", "minimum": 1},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "status": {"enum": ["pass", "fail"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "label", "required", "status", "evidence", "recommendation"],
        "properties": {
          "check_id": {"type": "string", "pattern": "^SEO-[A-Z0-9_-]{2,40}$"},
          "label": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["pass", "fail", "warning", "not_applicable"]},
          "evidence": {"type": "string", "minLength": 1},
          "recommendation": {"type": ["string", "null"]}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/finding"}},
    "required_changes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
