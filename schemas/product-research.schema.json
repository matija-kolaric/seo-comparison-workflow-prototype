{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-research.schema.json",
  "title": "Product research artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "subject", "generated_at", "sources", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "common.schema.json#/$defs/runId"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["competitor", "seobility"]}
      }
    },
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/source"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/evidenceRecord"}
    }
  }
}
